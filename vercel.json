{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(hero|anim|arcana|build|face)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ],
  "functions": {
    "api/ai.js": {
      "maxDuration": 60
    }
  }
}
